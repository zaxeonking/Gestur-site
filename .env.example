# Base URL API playlist (default: https://api.nexadev.my.id)
# VITE_API_BASE_URL=https://api.nexadev.my.id

# Saat development, jika terkena error CORS, pakai proxy bawaan Vite:
# VITE_API_BASE_URL=/nexa

# API download berbasis tautan lagu (default: https://app.kyzznekoo.my.id).
# Jika VITE_API_BASE_URL=/nexa, otomatis memakai proxy /kyzz.
# VITE_DOWNLOAD_API_BASE_URL=https://app.kyzznekoo.my.id
